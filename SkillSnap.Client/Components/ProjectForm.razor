@page "/add-project"
@using SkillSnap.Client.Models
@using SkillSnap.Client.Services
@using Microsoft.AspNetCore.Components.Forms
@inject ProjectService ProjectService
@inject IAuthService AuthService
@inject UserSessionService Session

@if (!Session.IsReady)
{
    <p class="text-muted">⏳ Loading user data...</p>
}
else if (Session.IsAdmin)
{
    <p class="text-muted">Role: @Session.Role | Admin: @Session.IsAdmin.ToString()</p>

    <h3 class="mb-4">📁 Add Project</h3>

    <EditForm Model="@newProject" OnValidSubmit="HandleValidSubmit">
        <DataAnnotationsValidator />
        <ValidationSummary />

        <div class="mb-3">
            <label for="title" class="form-label">Title:</label>
            <InputText id="title" name="title"
                       @bind-Value="newProject.Title"
                       class="form-control" />
            <ValidationMessage For="@(() => newProject.Title)" />
        </div>

        <div class="mb-3">
            <label for="description" class="form-label">Description:</label>
            <InputTextArea id="description" name="description"
                           @bind-Value="newProject.Description"
                           class="form-control" />
            <ValidationMessage For="@(() => newProject.Description)" />
        </div>

        <button type="submit" class="btn btn-primary">🚀 Add</button>
    </EditForm>
}
else
{
    <p class="text-muted">Role: @Session.Role | Admin: @Session.IsAdmin.ToString()</p>
    <p class="alert alert-danger">🚫 Only admins can add projects.</p>
}

@if (!string.IsNullOrWhiteSpace(statusMessage))
{
    <div class="alert alert-info mt-4">@statusMessage</div>
}

@code {
    private ProjectDto newProject = new()
    {
        Title = string.Empty,
        Description = string.Empty
    };

    private string statusMessage = string.Empty;

    private async Task HandleValidSubmit()
    {
        try
        {
            await ProjectService.AddProjectAsync(newProject);
            statusMessage = "✅ Project successfully added!";
            newProject = new()
            {
                Title = string.Empty,
                Description = string.Empty
            };
        }
        catch (Exception ex)
        {
            statusMessage = $"❌ Error adding: {ex.Message}";
        }
    }
}




